# --------------------------------------------------------------------------- #
# Crypto Arbitrage Scanner — example environment file
#
# Copy to `.env` and adjust. `.env` is git-ignored and MUST NEVER be committed.
#
# PLACEHOLDER VALUES ONLY. This file must never contain a real secret.
#
# Phase 0 requires NO exchange API credentials. The scanner is read-only and
# uses public market-data endpoints. Credential variables will be added, with
# documented least-privilege requirements, only in the phase that needs them.
# Withdrawal permission is never requested by this project.
#
# Unknown keys in `.env` are rejected (config uses extra="forbid"), so a typo
# fails loudly instead of being silently ignored.
# --------------------------------------------------------------------------- #

# Application environment: development | staging | production
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Starting capital used by the (later-phase) route evaluation, in INR.
# Parsed as an exact Decimal. Must be > 0. Never write this as a float literal
# in code — this value exists in configuration precisely so it is not hardcoded.
INITIAL_CAPITAL_INR=1000

# Maximum tolerated age of market data, in seconds. Parsed as an exact Decimal.
# Data older than this must be reported as STALE_DATA, never as an opportunity.
MAX_DATA_AGE_SECONDS=5
